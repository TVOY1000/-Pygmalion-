# Pygmalion v0.3.2 — Production Environment Variables
# Canon v1.0 · Этический стоп-кран активен
#
# Скопируйте этот файл в .env и измените значения на безопасные

# ==================== PostgreSQL ====================
# Пароль для PostgreSQL (измените на сложный!)
POSTGRES_PASSWORD=pygmalion_prod_secure_2026_change_me

# ==================== Activepieces ====================
# API ключ для Activepieces
AP_API_KEY=pygmalion_ap_secure_2026_change_me

# Ключ шифрования (32 символа)
AP_ENCRYPTION_KEY=change_this_to_random_32_chars

# ==================== Grafana ====================
# Пароль администратора Grafana
GRAFANA_PASSWORD=grafana_admin_secure_2026_change_me

# ==================== pgAdmin ====================
# Email для pgAdmin
PGADMIN_EMAIL=admin@pygmalion.local

# Пароль для pgAdmin
PGADMIN_PASSWORD=pgadmin_secure_2026_change_me

# ==================== NiFi ====================
# Пароль для NiFi (измените!)
NIFI_PASSWORD=nifi_admin_secure_2026_change_me

# ==================== Redis ====================
# Пароль для Redis (опционально, для production рекомендуется)
REDIS_PASSWORD=redis_secure_2026_change_me

# ==================== SSL/TLS ====================
# Путь к SSL сертификату (для HTTPS)
SSL_CERT_PATH=/etc/nginx/ssl/server.crt

# Путь к SSL ключу
SSL_KEY_PATH=/etc/nginx/ssl/server.key

# ==================== Monitoring ====================
# Telegram bot для алертов (опционально)
TELEGRAM_BOT_TOKEN=

# Telegram chat ID для алертов (опционально)
TELEGRAM_CHAT_ID=

# Email для алертов (опционально)
ALERT_EMAIL=

# ==================== Backup ====================
# S3 bucket для backup (опционально)
S3_BUCKET=

# S3 region
S3_REGION=

# S3 access key
S3_ACCESS_KEY=

# S3 secret key
S3_SECRET_KEY=
