# Pygmalion Business Metrics Exporter
# Canon v1.0

FROM python:3.11-slim

WORKDIR /app

# Установка зависимостей
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Копирование кода экспортера
COPY pygmalion_exporter.py .

# Порт для сбора метрик
EXPOSE 9187

# Запуск экспортера
CMD ["python", "pygmalion_exporter.py"]
